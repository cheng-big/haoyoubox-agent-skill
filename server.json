{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "com.haoyoubox/publish",
  "title": "HaoyouBox Publish",
  "description": "Publish local HTML or Markdown as expiring password-protected HaoyouBox links.",
  "websiteUrl": "https://www.haoyoubox.com/agent",
  "repository": {
    "url": "https://github.com/cheng-big/haoyoubox-agent-skill",
    "source": "github"
  },
  "version": "1.0.0",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "haoyoubox-mcp",
      "version": "1.0.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "HAOYOUBOX_TOKEN",
          "description": "Optional publish-only HaoyouBox Agent token",
          "isRequired": false,
          "isSecret": true
        }
      ]
    }
  ]
}
